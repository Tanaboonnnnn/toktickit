// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([active, name])
}

model User {
  id                 Int            @id @default(autoincrement())
  name               String
  email              String         @unique
  active             Boolean        @default(true)
  role               UserRole       @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean        @default(true)
  authVersion        Int            @default(1)
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  submittedTickets   Ticket[]       @relation("TicketRequester")
  ownedTickets       Ticket[]       @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  recordedActions    ActionTaken[]         @relation("ActionRecorder")
  assignedActions    ActionTaken[]         @relation("ActionAssignee")
  performedActions   ActionTaken[]         @relation("ActionPerformer")
  updatedActions     ActionTaken[]         @relation("ActionUpdater")
  cancelledActions   ActionTaken[]         @relation("ActionCanceller")
  actionRevisions    ActionTakenRevision[] @relation("ActionRevisionActor")
  workflowEvents     TicketWorkflowEvent[] @relation("TicketWorkflowActor")

  @@index([active, name])
  @@index([active, role, name, id])
  @@map("RequesterUser")
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([active, name])
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  clientRequestId   String            @unique
  requesterId       Int
  ownerId           Int?
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        RequestedPriority
  currentStatus     TicketStatus      @default(NEW)
  version           Int               @default(1)
  workflowCycle     Int               @default(1)
  resolutionSummary String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  requesterResolutionIndicatedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  requester         User              @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner             User?             @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem     RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]
  actionsTaken      ActionTaken[]
  workflowEvents    TicketWorkflowEvent[]

  @@index([requesterId, updatedAt, id])
  @@index([requesterId, createdAt, id])
  @@index([requesterId, categoryId])
  @@index([requesterId, requestedPriority])
  @@index([requesterId, currentStatus])
  @@index([ownerId, currentStatus, updatedAt, id])
  @@index([currentStatus, itPriority, updatedAt, id])
}

model ActionTaken {
  id                 Int          @id @default(autoincrement())
  ticketId           Int
  workflowCycle      Int          @default(1)
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  recordedById       Int
  assigneeId         Int
  performedById      Int?
  description        String
  result             String?
  followUpRequired   Boolean      @default(false)
  followUpNote       String?
  attachmentNotes    String?
  status             ActionStatus @default(PENDING)
  version            Int          @default(1)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)
  updatedById        Int
  completedAt        DateTime?    @db.Timestamptz(6)
  cancelledAt        DateTime?    @db.Timestamptz(6)
  cancelledById      Int?
  cancellationReason String?
  clientRequestId    String
  createFingerprint  String
  ticket             Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  recordedBy         User         @relation("ActionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  assignee           User         @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  performedBy        User?        @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  updatedBy          User         @relation("ActionUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  cancelledBy        User?        @relation("ActionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  revisions          ActionTakenRevision[]

  @@unique([recordedById, clientRequestId])
  @@index([ticketId, workflowCycle, status])
  @@index([ticketId, createdAt, id])
  @@index([recordedById, updatedAt, id])
  @@index([assigneeId, status, updatedAt, id])
  @@index([performedById, updatedAt, id])
}

model ActionTakenRevision {
  id            Int         @id @default(autoincrement())
  actionId      Int
  actionVersion Int
  eventType     String
  actorId       Int
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  snapshot      Json
  action        ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor         User        @relation("ActionRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actionId, actionVersion])
  @@index([actionId, createdAt, id])
  @@index([actorId, createdAt, id])
}

model TicketWorkflowEvent {
  id                Int          @id @default(autoincrement())
  ticketId          Int
  ticketVersion     Int
  workflowCycle     Int
  fromStatus        TicketStatus
  toStatus          TicketStatus
  actorId           Int
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  resolutionSummary String?
  cancellationReason String?
  ticket            Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor             User         @relation("TicketWorkflowActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, ticketVersion])
  @@index([ticketId, createdAt, id])
  @@index([actorId, createdAt, id])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  originalName  String
  storedName    String    @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime  @default(now())
  removedAt     DateTime?
  removalReason String?
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt, createdAt])
  @@index([ticketId, id])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId, createdAt, id])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("session")
}
