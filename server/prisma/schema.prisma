// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([active, name])
}

model User {
  id                 Int            @id @default(autoincrement())
  name               String
  email              String         @unique
  active             Boolean        @default(true)
  role               UserRole       @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean        @default(true)
  authVersion        Int            @default(1)
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  submittedTickets   Ticket[]       @relation("TicketRequester")
  ownedTickets       Ticket[]       @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]

  @@index([active, name])
  @@index([active, role, name, id])
  @@map("RequesterUser")
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([active, name])
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  clientRequestId   String            @unique
  requesterId       Int
  ownerId           Int?
  categoryId        Int
  relatedSystemId   Int
  summary           String
  description       String
  requestedPriority RequestedPriority
  itPriority        RequestedPriority
  currentStatus     TicketStatus      @default(NEW)
  version           Int               @default(1)
  resolutionSummary String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  requesterResolutionIndicatedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  requester         User              @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner             User?             @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem     RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]

  @@index([requesterId, updatedAt, id])
  @@index([requesterId, createdAt, id])
  @@index([requesterId, categoryId])
  @@index([requesterId, requestedPriority])
  @@index([requesterId, currentStatus])
  @@index([ownerId, currentStatus, updatedAt, id])
  @@index([currentStatus, itPriority, updatedAt, id])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  originalName  String
  storedName    String    @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime  @default(now())
  removedAt     DateTime?
  removalReason String?
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt, createdAt])
  @@index([ticketId, id])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([authorId, createdAt, id])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("session")
}
